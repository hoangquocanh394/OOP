import java.util.*;
public class Main{
    public static boolean isPangram(String sentence){
        HashSet<Character> s=new HashSet<>();//khong dung kieu nguyen thuy nen char->Character;int->Integer; con lai thi viet hoa chu dau
        for(int i=0;i<sentence.length();i++){
            s.add(sentence.charAt(i));
        }
        if(s.size()==26){
            return true;
        }else{
            return false;
        }
    }
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        sc.nextLine();
        while(t>0){
            t--;
            String k=sc.nextLine();
            System.out.println(isPangram(k));
        }
        sc.close();
    }
}
