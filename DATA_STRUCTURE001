import java.util.*;
class Student{
    private int id;
    private String name;
    private double cgpa;
    public Student(int id,String name,double cgpa){
        this.id=id;
        this.name=name;
        this.cgpa=cgpa;
    }
    public int getId(){
        return id;
    }
    public String getName(){
        return name;
    }
    public double getCgpa(){
        return cgpa;
    }
}
class Priorities{
    private ArrayList<Student> s;
    public Priorities(){
        s=new ArrayList<>();
    }
    public void enter(Student a){
        s.add(a);
    }
    public void sort(){
        for(int i=0;i<s.size()-1;i++){
            for(int j=0;j<s.size()-i-1;j++){
                if(s.get(j).getCgpa()<s.get(j+1).getCgpa()){
                    Student tmp=s.get(j);
                    s.set(j,s.get(j+1));
                    s.set(j+1,tmp);
                }else if(s.get(j).getCgpa()==s.get(j+1).getCgpa() && s.get(j).getName().compareTo(s.get(j+1).getName())>0){
                    Student tmp=s.get(j);
                    s.set(j,s.get(j+1));
                    s.set(j+1,tmp);
                }else if(s.get(j).getCgpa()==s.get(j+1).getCgpa() && s.get(j).getName().equals(s.get(j+1).getName())&&s.get(j).getId()>s.get(j+1).getId()){
                    Student tmp=s.get(j);
                    s.set(j,s.get(j+1));
                    s.set(j+1,tmp);
                }
            }
        }
    }
    public void served(){
        sort();
        if(!s.isEmpty()){
            s.remove(s.get(0));
        }
    }
    public void display(){
        if(!s.isEmpty()){
            for(int i=0;i<s.size();i++){
                System.out.println(s.get(i).getName());
            }
        }else{
            System.out.println("EMPTY");
        }
        
    }
}
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        sc.nextLine();
        Priorities p=new Priorities();
        while(t-->0){
            String s=sc.nextLine();
            String[] k=s.split(" ");
            if(k[0].equals("ENTER")){
                Student st=new Student(Integer.parseInt(k[3]),k[1],Double.parseDouble(k[2]));
                p.enter(st);
            }else{
                p.served();
            }
        }
        p.display();
    }
}
