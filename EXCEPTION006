import java.util.*;
class NotContainVowelException extends Exception{
    public NotContainVowelException(String s){
        super(s);
    }
}
class Check{
    private String s;
    public Check(String s) throws NotContainVowelException{
        this.s=s;
        s=s.toLowerCase();
        boolean k=true;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='a'||s.charAt(i)=='e'||s.charAt(i)=='i'||s.charAt(i)=='o'||s.charAt(i)=='u'){
                k=false;
                break;
            }
        }
        if(k==false)
            throw new NotContainVowelException("String has vowels");
        System.out.println("String not contain vowels");
    }
}
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        sc.nextLine();
        while(t-->0){
            String s=sc.nextLine();
            try{
                Check c=new Check(s);
            }catch(NotContainVowelException e){
                System.out.println(e.getMessage());
            }
        }
    }
}
