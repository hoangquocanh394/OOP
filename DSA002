import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        while(t-->0){
            int n=sc.nextInt();
            int k=sc.nextInt();
            int[] a=new int[n];
            for(int i=0;i<n;i++){
                a[i]=sc.nextInt();
            }
            int c=k;
            if(k>n-k){
                c=n-k;
            }
            Arrays.sort(a);
            int min=0;
            int max=0;
            for(int i=0;i<c;i++){
                min+=a[i];
            }
            for(int i=c;i<n;i++){
                max+=a[i];
            }
            System.out.println(max-min);
        }
    }
}
