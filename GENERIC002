import java.util.*;
public class Main{
    public static <T> int findFirstMatch (T[] array,T target){
        for(int i=0;i<array.length;i++){
            if(target.equals(array[i])){
                return i;
            }
        }
        return -1;
    }
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        sc.nextLine();
        while(t-->0){
            String s=sc.nextLine();
            String[] k=s.split("\\|");// | phai can co \\ o truoc
            k[1]=k[1].trim();
            k[0]=k[0].trim();
            String[] x=k[0].split(" ");
            System.out.println(findFirstMatch(x,k[1]));
        }
    }
}
