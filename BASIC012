import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        sc.nextLine();
        while(t-->0){
            String s=sc.nextLine();
            String[] k=s.split(" ");
            int n=k.length;
            int[] a=new int[n];
            for(int i=0;i<n;i++){
                a[i]=Integer.parseInt(k[i]);
            }
            int c=1;
            int max=1;
            for(int i=0;i<n-1;i++){
                if(a[i+1]>=a[i]){
                    c++;
                }else{
                    c=1;
                }
                max=Math.max(max,c);
            }
            if(n==0){
                System.out.println(0);
            }else{
                System.out.println(max);
            }
        }
    }
}
