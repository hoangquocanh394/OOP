import java.util.*;
class Pair<T>{
    private T first;
    private T second;
    public Pair(T first,T second){
        this.first=first;
        this.second=second;
    }
    public void swap(){
        T tmp;
        tmp=first;
        first=second;
        second=tmp;
    }
    public void in(){
        String x=first.toString();//phai ep ve kieu String thi moi dung duoc chatAt
        String y=second.toString();
        if(x.charAt(0)>='0'&&x.charAt(0)<='9'){
            System.out.println(x+" "+y);
        }else{
            System.out.println("'"+x+"' '"+y+"'");
        }
    }
}
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        sc.nextLine();
        while(t-->0){
            String s=sc.nextLine();
            String[] k=s.split(" ");
            Pair<String> p=new Pair<String>(k[0],k[1]);
            p.swap();
            p.in();
        }
    }
}
