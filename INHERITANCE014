import java.util.*;
abstract class Vehicle{
    private double price;
    public Vehicle(double price){
        this.price=price;
    }
    public abstract double calculateTax();
    public double getPrice(){
        return price;
    }
    public abstract String getType();
}
class Car extends Vehicle{
    private int numberOfSeats;
    public Car(double price,int numberOfSeats){
        super(price);
        this.numberOfSeats=numberOfSeats;
    }
    public double calculateTax(){
        return this.getPrice() * 0.05;
    }
    public String getType(){
        return "Car";
    }
    public int getNumberOfSeats(){
        return numberOfSeats;
    }
}
class Truck extends Vehicle{
    private double loadCapacity;
    public Truck(double price,double loadCapacity){
        super(price);
        this.loadCapacity=loadCapacity;
    }
    public double calculateTax(){
        return this.getPrice() * 0.1 + loadCapacity * 1000;
    }
    public String getType(){
        return "Truck";
    }
    public double getLoadCapacity(){
        return loadCapacity;
    }
}
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        sc.nextLine();
        System.out.println("Danh sách phương tiện và thuế:");
        double sum=0;
        while(t-->0){
            String s=sc.nextLine();
            String[] k=s.split(" ");
            if(k[0].equals("Car")){
                Car c=new Car(Double.parseDouble(k[1]),Integer.parseInt(k[2]));
                System.out.printf("Car - Giá: %.2f, Số ghế: %d, Thuế: %.2f",c.getPrice(),c.getNumberOfSeats(),c.calculateTax());//d khong can dau cham
                sum+=c.calculateTax();
            }else{
                Truck c=new Truck(Double.parseDouble(k[1]),Double.parseDouble(k[2]));
                System.out.printf("Truck - Giá: %.2f, Tải trọng: %.2f tấn, Thuế: %.2f",c.getPrice(),c.getLoadCapacity(),c.calculateTax());
                sum+=c.calculateTax();
            }
            System.out.println();
            if(t==0){
                System.out.printf("Tổng thuế phải đóng: %.2f",sum);
                System.out.println();
            }
        }
        sc.close();
    }
}
