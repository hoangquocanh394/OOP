import java.util.*;
class Vector2D{
    private int dx;
    private int dy;
    public Vector2D(int dx,int dy){
        this.dx=dx;
        this.dy=dy;
    }
    public void translate(int tx, int ty){
        dx+=tx;
        dy+=ty;
    }
    public double magnitude(){
        return Math.sqrt(dx*dx+dy*dy);
    }
}
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        while(t-->0){
            Vector2D v=new Vector2D(sc.nextInt(),sc.nextInt());
            v.translate(-2,3);
            System.out.printf("%.3f",v.magnitude());//.f ->float,double;.d->int
            System.out.println();
        }
    }
}
